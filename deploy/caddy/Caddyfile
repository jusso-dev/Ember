# TLS edge for Ember (homelab production profile).
# Replace ember.example.com with your hostname (LAN DNS or Tailscale MagicDNS).
#
#   caddy run --config deploy/caddy/Caddyfile
#
# Or docker: mount this file into caddy:2 and publish 80/443.

{$EMBER_DOMAIN:ember.local} {
	encode gzip

	# Dashboard + static (Next.js)
	handle {
		reverse_proxy {$EMBER_WEB_UPSTREAM:127.0.0.1:3200}
	}

	# Control plane API + agent WebSocket
	handle /api/* {
		reverse_proxy {$EMBER_CP_UPSTREAM:127.0.0.1:8080}
	}
}

# Optional: plain HTTP for LAN-only lab (no certs)
